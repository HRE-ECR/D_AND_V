<Window x:Class="ProformaViewer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Proforma Viewer" WindowState="Maximized" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" MinWidth="850" MinHeight="560" Background="#F3F6FA">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="#172033" Padding="26,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PROFORMA VIEWER" Foreground="White" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="SubTitle" Text="Choose a fleet database" Foreground="#B8C5D9" Margin="0,4,0,0"/></StackPanel><Button x:Name="FolderButton" Grid.Column="1" Width="38" Height="34" Padding="0" Margin="0,0,8,0" Background="#334155" Foreground="White" Visibility="Collapsed" ToolTip="Open database folder" Click="Folder_Click"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="17"/></Button><Button x:Name="FleetButton" Grid.Column="2" Content="Change Fleet" FontSize="12" Padding="11,7" Background="#334155" Foreground="White" Visibility="Collapsed" Click="Home_Click"/></Grid></Border>
<Border Grid.Row="1" Background="White" Padding="24,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="InstructionText" Text="Select a fleet to begin" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ComboBox x:Name="FrequencyBox" Grid.Column="2" HorizontalAlignment="Center" Width="170" Height="36" VerticalContentAlignment="Center" Visibility="Collapsed" SelectionChanged="FrequencyBox_SelectionChanged"><ComboBoxItem Content="Select frequency" IsSelected="True" IsEnabled="False"/></ComboBox><Button x:Name="SelectAllButton" Grid.Column="3" Content="Select all" Click="SelectAll_Click" Visibility="Collapsed"/><Button x:Name="ClearButton" Grid.Column="4" Content="Clear" Click="Clear_Click" Margin="8,0,0,0" Visibility="Collapsed"/></Grid></Border>
<Grid Grid.Row="2"><StackPanel x:Name="HomePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Width="620"><TextBlock Text="Select fleet" HorizontalAlignment="Center" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Ink}"/><TextBlock Text="The latest workbook is loaded from the network when selected." HorizontalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,8,0,28"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="AT300" Tag="AT300" Click="Database_Click" Style="{StaticResource PrimaryButton}" FontSize="24" Height="115" Margin="8"/><Button Grid.Column="1" Content="AT200" Tag="AT200" Click="Database_Click" Style="{StaticResource PrimaryButton}" FontSize="24" Height="115" Margin="8"/></Grid></StackPanel>
<ListBox x:Name="ItemsList" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="18" SelectionMode="Multiple" SelectionChanged="ItemsList_SelectionChanged" PreviewMouseLeftButtonDown="ItemsList_PreviewMouseLeftButtonDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel IsItemsHost="True"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Width" Value="345"/><Setter Property="MinHeight" Value="132"/><Setter Property="Margin" Value="7"/><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tile" Padding="17" Background="White" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="10"><Grid><ContentPresenter/><Border x:Name="Badge" HorizontalAlignment="Right" VerticalAlignment="Top" Width="25" Height="25" CornerRadius="13" Background="#2563EB" Visibility="Collapsed"><TextBlock Text="✓" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#F7FAFF"/><Setter TargetName="Tile" Property="BorderBrush" Value="#7EA6F8"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="#E8F0FF"/><Setter TargetName="Tile" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="Tile" Property="BorderThickness" Value="2"/><Setter TargetName="Badge" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,0,30,0"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource Ink}" FontSize="14"/><TextBlock Text="{Binding PageLabel}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,9,0,0"/><TextBlock Text="{Binding FileName}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding Path}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
<Border Grid.Row="3" Background="White" Padding="22,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><ProgressBar Grid.Column="1" x:Name="Progress" Width="150" Height="8" Margin="0,0,15,0" Visibility="Collapsed"/><Button Grid.Column="2" x:Name="ExportButton" Content="Export selected pages" Style="{StaticResource PrimaryButton}" Click="Export_Click" IsEnabled="False" Visibility="Collapsed"/></Grid></Border></Grid></Window>
